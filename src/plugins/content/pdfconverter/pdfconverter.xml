<?xml version="1.0" encoding="utf-8" ?>
<extension type="plugin" group="content" method="upgrade">
	<name>plg_content_pdfconverter</name>
	<author>Peter Szalatnay</author>
	<creationDate>##DATE##</creationDate>
	<copyright>Copyright (C) 2007 - ##YEAR## Flygcert FZE. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>info@flygcert.com</authorEmail>
	<authorUrl>flygcert.com</authorUrl>
	<version>##VERSION##</version>
	<description>PLG_CONTENT_PDFCONVERTER_XML_DESCRIPTION</description>
	<namespace path="src">Flygcert\Plugin\Content\PDFConverter</namespace>

	<files>
		##FILES##
	</files>

    <config>
		<fields name="params">
			<fieldset name="basic">
                <field
                    name="enable_logging"
                    type="radio"
                    label="PLG_CONTENT_PDFCONVERTER_ENABLE_LOGGING_LABEL"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="base_path"
                    type="text"
                    default=""
                    label="PLG_CONTENT_PDFCONVERTER_BASE_PATH_LABEL"
                />

                <field
                    name="custom_fonts"
                    type="editor"
                    label="PLG_CONTENT_PDFCONVERTER_CUSTOM_FONTS_LABEL"
                    description="PLG_CONTENT_PDFCONVERTER_CUSTOM_FONTS_DESC"
                    editor="codemirror|none"
                    buttons="false"
                    height="150"
                    filter="raw"
                />
			</fieldset>
		</fields>
	</config>
</extension>
